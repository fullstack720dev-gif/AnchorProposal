{
  "name": "anchorproposal",
  "private": true,
  "scripts": {
    "dev:web": "node init && pnpm --filter @anchorproposal/web dev",
    "dev:api": "node init && pnpm --filter @anchorproposal/api dev",
    "dev": "node init && pnpm --parallel --filter @anchorproposal/web --filter @anchorproposal/api run dev",
    "share": "powershell -ExecutionPolicy Bypass -File ./scripts/start-share.ps1",
    "build": "node init && pnpm --filter @anchorproposal/shared build && pnpm --filter @anchorproposal/api build && pnpm --filter @anchorproposal/web build",
    "build:api": "node init && pnpm --filter @anchorproposal/shared build && pnpm --filter @anchorproposal/api build",
    "build:web": "node init && pnpm --filter @anchorproposal/web build",
    "start:api": "node init && pnpm --filter @anchorproposal/api start",
    "start:web": "node init && pnpm --filter @anchorproposal/web start",
    "start": "node init && pnpm --parallel --filter @anchorproposal/web --filter @anchorproposal/api run start",
    "lint": "pnpm --filter @anchorproposal/web lint",
    "db:migrate": "pnpm --filter @anchorproposal/api db:migrate",
    "db:seed": "pnpm --filter @anchorproposal/api db:seed",
    "db:generate": "pnpm --filter @anchorproposal/api db:generate",
    "test": "pnpm --filter @anchorproposal/shared build && npx ts-node scripts/test-unit.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
